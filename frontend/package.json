{
  "name": "realtime-canvas-frontend",
  "version": "1.0.0",
  "description": "Frontend server for realtime canvas application",
  "main": "server.ts",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "start": "node build.mjs && ts-node --project tsconfig.json server.ts",
    "dev": "ts-node --project tsconfig.json server.ts",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.49",
    "ably": "^2.0.0",
    "ai": "^6.0.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.24.2",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
