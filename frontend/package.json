{
  "name": "realtime-canvas-frontend",
  "version": "1.0.0",
  "description": "Frontend server for realtime canvas application",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node --project tsconfig.json server.ts",
    "dev": "ts-node --project tsconfig.json server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='(unit)' --coverage",
    "test:functional": "jest --testPathPattern='(functional)' --coverage",
    "test:e2e": "jest --testPathPattern='(e2e)' --testTimeout=30000",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.3",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/ws": "^8.5.4",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-mock-extended": "^3.0.4",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.1"
  }
}
