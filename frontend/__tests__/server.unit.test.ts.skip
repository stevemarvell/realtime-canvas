import * as http from 'http';
import express from 'express';
import WebSocket from 'ws';
import path from 'path';

const WebSocketServer = require('ws').Server;

describe('Server Unit Tests', () => {
  let server: http.Server;
  let wss: any;
  let clients: Set<any>;
  let PORT = 0;

  beforeEach(() => {
    clients = new Set<any>();
    const app = express();

    app.use(express.static(path.join(__dirname, '../public')));
    app.get('/', (req, res) => {
      res.sendFile(path.join(__dirname, '../public/index.html'));
    });

    server = http.createServer(app);
    wss = new WebSocketServer({ server, path: '/connect' });

    wss.on('connection', (ws: WebSocket) => {
      clients.add(ws);

      ws.on('message', (data: string) => {
        try {
          const message = JSON.parse(data);
          clients.forEach(client => {
            if (client !== ws && client.readyState === WebSocket.OPEN) {
              client.send(JSON.stringify(message));
            }
          });
        } catch (error) {
          console.error('Error processing message:', error);
        }
      });

      ws.on('close', () => {
        clients.delete(ws);
      });

      ws.on('error', (error: Error) => {
        console.error('WebSocket error:', error);
      });
    });
  });

  afterEach(() => {
    return new Promise<void>(resolve => {
      clients.forEach(client => {
        if (client.readyState === WebSocket.OPEN) {
          client.close();
        }
      });
      wss.close(() => {
        server.close(() => {
          resolve();
        });
      });
    });
  });

  // Server initialization tests
  describe('Server Initialization', () => {
    it('should start HTTP server on specified port', done => {
      server.listen(0, () => {
        const port = (server.address() as any).port;
        expect(port).toBeGreaterThan(0);
        done();
      });
    });

    it('should have WebSocket server configured', () => {
      expect(wss).toBeDefined();
      expect(wss.options.path).toBe('/connect');
    });

    it('should start with empty clients set', () => {
      expect(clients.size).toBe(0);
    });

    it('should serve static files', async () => {
      await new Promise<void>(resolve => {
        server.listen(0, () => {
          const port = (server.address() as any).port;
          // Just verify server is listening
          expect(server.listening).toBe(true);
          resolve();
        });
      });
    });
  });

  // Client connection tests
  describe('Client Connection Management', () => {
    beforeEach(async () => {
      await new Promise<void>(resolve => {
        server.listen(0, () => {
          resolve();
        });
      });
    });

    it('should add client to set on connection', done => {
      const port = (server.address() as any).port;
      const ws = new WebSocket(`ws://localhost:${port}/connect`);

      ws.on('open', () => {
        expect(clients.size).toBe(1);
        ws.close();
        done();
      });
    });

    it('should handle multiple concurrent connections', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws3 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const checkOpen = () => {
        openCount++;
        if (openCount === 3) {
          expect(clients.size).toBe(3);
          ws1.close();
          ws2.close();
          ws3.close();
          done();
        }
      };

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
      ws3.on('open', checkOpen);
    });

    it('should remove client from set on disconnect', done => {
      const port = (server.address() as any).port;
      const ws = new WebSocket(`ws://localhost:${port}/connect`);

      ws.on('open', () => {
        expect(clients.size).toBe(1);
        ws.close();
      });

      ws.on('close', () => {
        expect(clients.size).toBe(0);
        done();
      });
    });

    it('should handle multiple disconnections', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          expect(clients.size).toBe(2);
          ws1.close();
        }
      };

      let closeCount = 0;
      const checkClose = () => {
        closeCount++;
        if (closeCount === 1) {
          expect(clients.size).toBe(1);
          ws2.close();
        } else if (closeCount === 2) {
          expect(clients.size).toBe(0);
          done();
        }
      };

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
      ws1.on('close', checkClose);
      ws2.on('close', checkClose);
    });
  });

  // Message broadcasting tests
  describe('Message Broadcasting', () => {
    beforeEach(async () => {
      await new Promise<void>(resolve => {
        server.listen(0, () => {
          resolve();
        });
      });
    });

    it('should parse JSON messages correctly', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          const message = JSON.stringify({ x: 100, y: 200, timestamp: '2024-01-01T00:00:00Z' });
          ws1.send(message);
        }
      };

      ws2.on('message', (data: WebSocket.RawData) => {
        const message = JSON.parse(data.toString());
        expect(message.x).toBe(100);
        expect(message.y).toBe(200);
        expect(message.timestamp).toBe('2024-01-01T00:00:00Z');
        ws1.close();
        ws2.close();
        done();
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
    });

    it('should broadcast to all clients except sender', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws3 = new WebSocket(`ws://localhost:${port}/connect`);

      const receivedMessages: { client: string; message: any }[] = [];
      let openCount = 0;

      const checkOpen = () => {
        openCount++;
        if (openCount === 3) {
          const message = JSON.stringify({ x: 50, y: 75 });
          ws1.send(message);
        }
      };

      ws2.on('message', (data: WebSocket.RawData) => {
        receivedMessages.push({ client: 'ws2', message: JSON.parse(data.toString()) });
        if (receivedMessages.length === 2) {
          expect(receivedMessages.length).toBe(2);
          expect(receivedMessages[0].client).toBe('ws2');
          expect(receivedMessages[1].client).toBe('ws3');
          ws1.close();
          ws2.close();
          ws3.close();
          done();
        }
      });

      ws3.on('message', (data: WebSocket.RawData) => {
        receivedMessages.push({ client: 'ws3', message: JSON.parse(data.toString()) });
        if (receivedMessages.length === 2) {
          expect(receivedMessages.length).toBe(2);
          expect(receivedMessages[0].client).toBe('ws2');
          expect(receivedMessages[1].client).toBe('ws3');
          ws1.close();
          ws2.close();
          ws3.close();
          done();
        }
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
      ws3.on('open', checkOpen);
    });

    it('should not send message back to sender', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      let senderReceived = false;

      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          ws1.send(JSON.stringify({ x: 100, y: 100 }));

          // Set a timeout to check if ws1 receives its own message
          setTimeout(() => {
            ws1.close();
            ws2.close();
            expect(senderReceived).toBe(false);
            done();
          }, 200);
        }
      };

      ws1.on('message', () => {
        senderReceived = true;
      });

      ws2.on('message', () => {
        // ws2 received the message as expected
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
    });

    it('should handle multiple concurrent messages', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      const messages: any[] = [];
      let openCount = 0;

      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          ws1.send(JSON.stringify({ id: 1, x: 10 }));
          ws1.send(JSON.stringify({ id: 2, x: 20 }));
          ws1.send(JSON.stringify({ id: 3, x: 30 }));
        }
      };

      ws2.on('message', (data: WebSocket.RawData) => {
        messages.push(JSON.parse(data.toString()));
        if (messages.length === 3) {
          expect(messages[0].id).toBe(1);
          expect(messages[1].id).toBe(2);
          expect(messages[2].id).toBe(3);
          ws1.close();
          ws2.close();
          done();
        }
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
    });

    it('should skip clients with non-OPEN readyState', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws3 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const receivedByWs3: any[] = [];

      const checkOpen = () => {
        openCount++;
        if (openCount === 3) {
          // Close ws2
          ws2.close();
          setTimeout(() => {
            ws1.send(JSON.stringify({ x: 100 }));
          }, 50);
        }
      };

      ws3.on('message', (data: WebSocket.RawData) => {
        receivedByWs3.push(JSON.parse(data.toString()));
        ws1.close();
        ws2.close();
        ws3.close();
        done();
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
      ws3.on('open', checkOpen);
    });
  });

  // Error handling tests
  describe('Error Handling', () => {
    beforeEach(async () => {
      await new Promise<void>(resolve => {
        server.listen(0, () => {
          resolve();
        });
      });
    });

    it('should handle invalid JSON messages gracefully', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          // Send invalid JSON
          (ws1 as any).send('{invalid json}');
          setTimeout(() => {
            ws1.send(JSON.stringify({ x: 100 }));
          }, 100);
        }
      };

      let messageCount = 0;
      ws2.on('message', () => {
        messageCount++;
        if (messageCount === 1) {
          expect(messageCount).toBe(1);
          ws1.close();
          ws2.close();
          done();
        }
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
    });

    it('should continue operating after client error', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws3 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      let errorTriggered = false;

      const checkOpen = () => {
        openCount++;
        if (openCount === 3) {
          // Trigger error on ws1
          ws1.emit('error', new Error('Test error'));
          errorTriggered = true;

          setTimeout(() => {
            // ws2 should still be able to receive from ws3
            ws3.send(JSON.stringify({ x: 100 }));
          }, 100);
        }
      };

      ws2.on('message', (data: WebSocket.RawData) => {
        if (errorTriggered) {
          const message = JSON.parse(data.toString());
          expect(message.x).toBe(100);
          ws1.close();
          ws2.close();
          ws3.close();
          done();
        }
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
      ws3.on('open', checkOpen);
    });

    it('should handle WebSocket close event', done => {
      const port = (server.address() as any).port;
      const ws = new WebSocket(`ws://localhost:${port}/connect`);

      ws.on('open', () => {
        expect(clients.size).toBe(1);
        ws.close();
      });

      ws.on('close', () => {
        setTimeout(() => {
          expect(clients.size).toBe(0);
          done();
        }, 50);
      });
    });
  });

  // Message data integrity tests
  describe('Message Data Integrity', () => {
    beforeEach(async () => {
      await new Promise<void>(resolve => {
        server.listen(0, () => {
          resolve();
        });
      });
    });

    it('should preserve message data structure', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          const originalMessage = {
            x: 123,
            y: 456,
            timestamp: '2024-01-01T12:30:45.123Z',
            extra: 'data',
          };
          ws1.send(JSON.stringify(originalMessage));
        }
      };

      ws2.on('message', (data: WebSocket.RawData) => {
        const receivedMessage = JSON.parse(data.toString());
        expect(receivedMessage).toEqual({
          x: 123,
          y: 456,
          timestamp: '2024-01-01T12:30:45.123Z',
          extra: 'data',
        });
        ws1.close();
        ws2.close();
        done();
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
    });

    it('should handle large coordinate values', done => {
      const port = (server.address() as any).port;
      const ws1 = new WebSocket(`ws://localhost:${port}/connect`);
      const ws2 = new WebSocket(`ws://localhost:${port}/connect`);

      let openCount = 0;
      const checkOpen = () => {
        openCount++;
        if (openCount === 2) {
          const message = JSON.stringify({ x: 10000, y: 20000 });
          ws1.send(message);
        }
      };

      ws2.on('message', (data: WebSocket.RawData) => {
        const message = JSON.parse(data.toString());
        expect(message.x).toBe(10000);
        expect(message.y).toBe(20000);
        ws1.close();
        ws2.close();
        done();
      });

      ws1.on('open', checkOpen);
      ws2.on('open', checkOpen);
    });
  });
});
